# Keep addresses that the previous theme already published.
Redirect 301 /portfolio.html https://aafaq.com.pk/#experience
Redirect 301 /contact.html https://aafaq.com.pk/#contact
Redirect 301 /blog-3-columns.html https://aafaq.com.pk/
Redirect 301 /blog.html https://aafaq.com.pk/

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>

# Caching: HTML revalidates, static assets cached for a month
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/pdf "access plus 1 week"
</IfModule>

# Basic security headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
